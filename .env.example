# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Contact form server-side email delivery.
# Configure these only in the deployment environment; never expose them to Vite.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="BeUnion 官網 <noreply@gathertaiwan.com>"

# GA4 評估 ID（格式 G-xxxxxxxxxx）。留空則 src/lib/analytics.ts 不會載入 GA。
VITE_GA_MEASUREMENT_ID=
